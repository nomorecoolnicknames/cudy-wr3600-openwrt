
config settings 'settings'
	option dns_type 'udp'
	option dns_server '1.1.1.1'
	option bootstrap_dns_server '1.1.1.1'
	option dns_rewrite_ttl '60'
	option source_network_interfaces 'br-lan'
	option enable_output_network_interface '0'
	option enable_badwan_interface_monitoring '0'
	option enable_yacd '0'
	option disable_quic '0'
	option update_interval '1d'
	option download_lists_via_proxy '0'
	option dont_touch_dhcp '0'
	option config_path '/etc/sing-box/config.json'
	option cache_path '/tmp/sing-box/cache.db'
	option log_level 'debug'
	option exclude_ntp '0'
	option shutdown_correctly '0'
	option show_advanced_tabs '0'

config section 'main'
	option connection_type 'proxy'
	option proxy_config_type 'sota_subscription'
	option enable_udp_over_tcp '0'
	option user_subnet_list_type 'dynamic'
	list user_subnets '0.0.0.0/0'
	list user_subnets '::/0'

config sota_account 'sota_account'
	option api_url 'https://sota.ac'
	option desired 'disconnected'
	option mode 'ru_direct'
	option schema '3'
	option access_key ''
	option gate_id ''

