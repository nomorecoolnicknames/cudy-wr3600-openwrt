# enet66b - LAN-side link bring-up for the BCM6764 (Cudy WR3600):
#           Merlin16 serdes (core 0 lane 0, 2500Base-X) + external BCM53134.
#
# Set ENET66B_STANDALONE_MDIO=0 once the SoC-side driver in port66/enet66
# exports sf2_mdio_read()/sf2_mdio_write(); then enet66b_mdio.ko is neither
# built nor needed.

# Default 0: port66/enet66 exports sf2_mdio_read()/sf2_mdio_write(), and two
# modules exporting the same symbols cannot be loaded together. Set to 1 only
# for a standalone enet66b build (review S2-12).
ENET66B_STANDALONE_MDIO ?= 0

obj-m += serdes6764.o
obj-m += extsw6764.o

ifeq ($(ENET66B_STANDALONE_MDIO),1)
ccflags-y += -DENET66B_STANDALONE_MDIO
obj-m += enet66b_mdio.o
enet66b_mdio-y := sf2_mdio_local.o
endif

ccflags-y += -I$(src)
